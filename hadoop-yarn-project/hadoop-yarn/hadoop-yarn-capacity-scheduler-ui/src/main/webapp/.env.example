# YARN Scheduler UI - Environment Configuration
# Copy this file to .env and adjust values for your local environment

# -----------------------------------------------------------------------------
# Mock Service Mode
# -----------------------------------------------------------------------------

# Controls how the UI handles API requests in development:
#   static  - Serves JSON fixtures from public/mock/ws/v1/cluster (default, no cluster needed)
#   cluster - Connects to a real YARN cluster via dev server proxy
#   off     - Disables mocking entirely (for production builds)
VITE_API_MOCK_MODE=static

# -----------------------------------------------------------------------------
# Cluster Connection (when VITE_API_MOCK_MODE=cluster)
# -----------------------------------------------------------------------------

# To connect to a real YARN cluster in development, you only need to set:
# VITE_CLUSTER_PROXY_TARGET=http://rm-host:8088

# -----------------------------------------------------------------------------
# AI Assist Connection (PoC only)
# -----------------------------------------------------------------------------

# Leave unset to use the static mock AI Assist (default for demos, no Python needed)
# Set to point the UI at a running local Python service:
# VITE_YARN_ASSIST_PROXY_TARGET=http://localhost:8090

# Supported environment combinations:
#
# Static demo (default)  : VITE_API_MOCK_MODE=static, no VITE_YARN_ASSIST_PROXY_TARGET
#   - ResourceManager fixtures served from public/mock/ws/v1/cluster/
#   - AI Assist mock served by Vite dev plugin (no Python or model needed)
#
# Real RM + mock AI Assist: VITE_API_MOCK_MODE=cluster + VITE_CLUSTER_PROXY_TARGET
#   - Live data from ResourceManager
#   - AI Assist still uses the built-in mock
#
# Real RM + real AI Assist: VITE_API_MOCK_MODE=cluster + both proxy targets
#   - Full live mode: ResourceManager + Python AI Assist service
#   - Requires Python service running and YARN_ASSIST_MODEL configured

# -----------------------------------------------------------------------------
# Development/Testing Options
# -----------------------------------------------------------------------------

# Simulate read-only mode in development (only affects static mock mode)
# In production, read-only mode is controlled by the READ_ONLY_PROPERTY in YARN
VITE_READONLY_MODE=false

# Username for simple-authenticated clusters (injected as user.name query parameter)
VITE_YARN_USER_NAME=yarn
